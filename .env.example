# Settings for `npm run serve` (rapidoc serve with sign-in). Copy this file to `.env` and fill it in.
# `.env` is git-ignored: never commit the client secret. Variables already set in your shell win over this file.

# Auth0 → Applications → Rapid Parcels Portal → Settings
RAPIDOC_AUTH_CLIENT_ID=GGEXHM1XZ0BAIf6VVSzGgPmmMQadBWDR
RAPIDOC_AUTH_CLIENT_SECRET=

# Encrypts the session cookie; at least 32 characters. Generate one with: openssl rand -hex 32
# Changing it signs everyone out.
RAPIDOC_SESSION_SECRET=

# Where the portal runs; must match the callback URL registered in Auth0.
RAPIDOC_PUBLIC_URL=http://localhost:8090
