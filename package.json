{
  "name": "demo-api-portal",
  "version": "1.0.0",
  "description": "Rapid Parcels developer portal - the RapiDoc demo and dogfooding project for @rapidoc/cli, @rapidoc/portal and @rapidoc/server",
  "private": true,
  "scripts": {
    "dev": "node ../astro-rapidoc/packages/rapidoc-cli/src/index.js dev",
    "build": "node ../astro-rapidoc/packages/rapidoc-cli/src/index.js build",
    "serve": "node ../astro-rapidoc/packages/rapidoc-cli/src/index.js serve dist --port 8090",
    "validate": "node ../astro-rapidoc/packages/rapidoc-cli/src/index.js validate",
    "generate:admin": "node scripts/generate-admin-spec.mjs"
  },
  "keywords": [
    "rapidoc",
    "developer-portal",
    "openapi",
    "markdoc",
    "demo"
  ]
}
