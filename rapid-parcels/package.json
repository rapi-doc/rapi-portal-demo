{
  "name": "rapi-portal-demo",
  "version": "1.0.0",
  "description": "Rapid Parcels developer portal - the RapiDoc demo and dogfooding project for @rapidoc/cli, @rapidoc/portal and @rapidoc/server",
  "private": true,
  "scripts": {
    "dev": "node ../../rapidoc/packages/rapidoc-cli/src/index.js dev",
    "build": "node ../../rapidoc/packages/rapidoc-cli/src/index.js build",
    "serve": "node --env-file-if-exists=.env ../../rapidoc/packages/rapidoc-cli/src/index.js serve dist --port 8090",
    "mock": "node --env-file-if-exists=.env ../../rapidoc/packages/rapidoc-cli/src/index.js mock",
    "validate": "node ../../rapidoc/packages/rapidoc-cli/src/index.js validate",
    "generate:admin": "node scripts/generate-admin-spec.mjs"
  },
  "keywords": [
    "rapidoc",
    "developer-portal",
    "openapi",
    "markdoc",
    "demo"
  ]
}
